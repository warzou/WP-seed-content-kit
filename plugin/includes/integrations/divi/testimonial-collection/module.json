{
  "name": "wp-seed-content-kit/testimonial-collection",
  "d4Shortcode": "",
  "title": "WP Seed — Témoignages",
  "titles": "WP Seed — Témoignages",
  "category": "module",
  "moduleClassName": "wp_seed_content_kit_testimonial_collection",
  "moduleOrderClassName": "wp_seed_content_kit_testimonial_collection",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "WP Seed — Témoignages"
            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "text": {},
          "htmlAttributes": {}
        },
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "title": {
      "type": "object",
      "selector": "{{selector}} .wp-seed-divi-testimonial-collection__title",
      "default": {
        "innerContent": {
          "desktop": {
            "value": ""
          }
        },
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "headingLevel": "h2"
                }
              }
            }
          }
        }
      },
      "attributes": {
        "class": "wp-seed-divi-testimonial-collection__title"
      },
      "inlineEditor": "plainText",
      "elementType": "heading",
      "childrenSanitizer": "et_core_esc_previously",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentHeading",
            "priority": 10,
            "render": true,
            "attrName": "title.innerContent",
            "label": "Titre de la section",
            "description": "Titre facultatif affiché avant les témoignages.",
            "features": {
              "sticky": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        },
        "decoration": {
          "font": {
            "priority": 10,
            "component": {
              "props": {
                "groupLabel": "Titre",
                "fieldLabel": "Titre"
              }
            }
          }
        }
      }
    },
    "collection": {
      "type": "object",
      "selector": "{{selector}} .seed-testimonials",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "ids": "",
              "featured": "all",
              "context": "",
              "limit": "3",
              "orderby": "date",
              "order": "desc",
              "template": "native",
              "columns": "3"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "featured": {
              "groupSlug": "contentCollection",
              "priority": 10,
              "render": true,
              "subName": "featured",
              "label": "Témoignages mis en avant",
              "description": "Inclure tous les témoignages, uniquement ceux mis en avant ou les exclure.",
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "dynamicContent": false
              },
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "defaultValue": "all",
                  "options": {
                    "all": {"label": "Tous"},
                    "only": {"label": "Uniquement mis en avant"},
                    "exclude": {"label": "Exclure les mis en avant"}
                  }
                }
              }
            },
            "context": {
              "groupSlug": "contentCollection",
              "priority": 20,
              "render": true,
              "subName": "context",
              "label": "Contexte",
              "description": "Conserver uniquement les témoignages dont le contexte correspond exactement.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {"name": "divi/text", "type": "field"}
            },
            "ids": {
              "groupSlug": "contentCollection",
              "priority": 30,
              "render": true,
              "subName": "ids",
              "label": "IDs explicites",
              "description": "Liste d’identifiants séparés par des virgules. L’ordre saisi est conservé.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {"name": "divi/text", "type": "field"}
            },
            "limit": {
              "groupSlug": "contentCollection",
              "priority": 40,
              "render": true,
              "subName": "limit",
              "label": "Limite",
              "description": "Nombre maximum de témoignages. Zéro affiche toute la collection.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": {"min": 0, "max": 24, "minLimit": 0, "maxLimit": 24, "defaultUnit": "", "allowedUnits": [""]}
              }
            },
            "orderby": {
              "groupSlug": "contentCollection",
              "priority": 50,
              "render": true,
              "subName": "orderby",
              "label": "Tri",
              "description": "Critère de tri de la collection.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "defaultValue": "date",
                  "options": {
                    "display_order": {"label": "Ordre d’affichage"},
                    "date": {"label": "Date de publication"},
                    "testimonial_date": {"label": "Date du témoignage"},
                    "id": {"label": "Identifiant"}
                  }
                }
              }
            },
            "order": {
              "groupSlug": "contentCollection",
              "priority": 60,
              "render": true,
              "subName": "order",
              "label": "Ordre",
              "description": "Ordre croissant ou décroissant.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {"defaultValue": "desc", "options": {"asc": {"label": "Croissant"}, "desc": {"label": "Décroissant"}}}
              }
            },
            "template": {
              "groupSlug": "contentCollection",
              "priority": 70,
              "render": true,
              "subName": "template",
              "label": "Template Content Kit",
              "description": "Rendu natif ou Template Témoignages publié.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {"defaultValue": "native", "options": {"native": {"label": "Rendu natif"}}}
              }
            },
            "columns": {
              "groupSlug": "contentCollection",
              "priority": 80,
              "render": true,
              "subName": "columns",
              "label": "Colonnes",
              "description": "Nombre de colonnes du rendu natif sur grand écran.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {"defaultValue": "3", "options": {"1": {"label": "1"}, "2": {"label": "2"}, "3": {"label": "3"}, "4": {"label": "4"}}}
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "inner": {
      "subName": "inner",
      "label": "Conteneur interne",
      "selectorSuffix": " .wp-seed-divi-testimonial-collection__inner"
    },
    "collection": {
      "subName": "collection",
      "label": "Collection",
      "selectorSuffix": " .seed-testimonials"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentHeading": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentHeading",
        "multiElements": true,
        "component": {"name": "divi/composite", "props": {"groupLabel": "Titre"}}
      },
      "contentCollection": {
        "panel": "content",
        "priority": 20,
        "groupName": "contentCollection",
        "multiElements": true,
        "component": {"name": "divi/composite", "props": {"groupLabel": "Collection"}}
      }
    }
  }
}
