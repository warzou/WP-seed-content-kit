{
  "name": "wp-seed-content-kit/directory-collection",
  "d4Shortcode": "",
  "title": "WP Seed — Annuaire",
  "titles": "WP Seed — Annuaire",
  "category": "module",
  "moduleClassName": "wp_seed_content_kit_directory_collection",
  "moduleOrderClassName": "wp_seed_content_kit_directory_collection",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "WP Seed — Annuaire"
            }
          }
        }
      },
      "settings": {
        "meta": {"adminLabel": {}},
        "advanced": {"link": {}, "text": {}, "htmlAttributes": {}},
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "title": {
      "type": "object",
      "selector": "{{selector}} .wp-seed-divi-directory-collection__title",
      "default": {
        "innerContent": {"desktop": {"value": ""}},
        "decoration": {
          "font": {
            "font": {
              "desktop": {"value": {"headingLevel": "h2"}}
            }
          }
        }
      },
      "attributes": {"class": "wp-seed-divi-directory-collection__title"},
      "inlineEditor": "plainText",
      "elementType": "heading",
      "childrenSanitizer": "et_core_esc_previously",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentHeading",
            "priority": 10,
            "render": true,
            "attrName": "title.innerContent",
            "label": "Titre de la section",
            "description": "Titre facultatif affiché avant l’Annuaire.",
            "features": {"sticky": false, "dynamicContent": false},
            "component": {"name": "divi/text", "type": "field"}
          }
        },
        "decoration": {
          "font": {
            "priority": 10,
            "component": {"props": {"groupLabel": "Titre", "fieldLabel": "Titre"}}
          }
        }
      }
    },
    "collection": {
      "type": "object",
      "selector": "{{selector}} .wp-seed-directory",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "status": "all",
              "profile_types": "all",
              "profile_type_operator": "or",
              "seeking_models": "all",
              "department": "",
              "country": "",
              "featured": "all",
              "ids": "",
              "exclude_ids": "",
              "limit": "0",
              "offset": "0",
              "orderby": "display_order",
              "order": "asc",
              "template": "native"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "status": {
              "groupSlug": "contentCollection",
              "priority": 10,
              "render": true,
              "subName": "status",
              "label": "Statut",
              "description": "Afficher toutes les fiches, les personnes en exercice ou les personnes en recherche de modèles.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "defaultValue": "all",
                  "options": {
                    "all": {"label": "Tous"},
                    "practicing": {"label": "En exercice"},
                    "seeking_models": {"label": "En recherche de modèles"}
                  }
                }
              }
            },
            "profile_types": {
              "groupSlug": "contentCollection",
              "priority": 20,
              "render": true,
              "subName": "profile_types",
              "label": "Types de profil",
              "description": "Filtrer les profils Praticien et Intervenant.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "defaultValue": "all",
                  "options": {
                    "all": {"label": "Tous les types"},
                    "praticien": {"label": "Praticien"},
                    "intervenant": {"label": "Intervenant"},
                    "praticien,intervenant": {"label": "Praticien et Intervenant"}
                  }
                }
              }
            },
            "profile_type_operator": {
              "groupSlug": "contentCollection",
              "priority": 30,
              "render": true,
              "subName": "profile_type_operator",
              "label": "Relation entre les types",
              "description": "OU accepte au moins un type. ET exige tous les types sélectionnés.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "defaultValue": "or",
                  "options": {"or": {"label": "OU"}, "and": {"label": "ET"}}
                }
              }
            },
            "seeking_models": {
              "groupSlug": "contentCollection",
              "priority": 40,
              "render": true,
              "subName": "seeking_models",
              "label": "Recherche de modèles",
              "description": "Inclure toutes les fiches, uniquement celles qui recherchent des modèles ou les exclure.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "defaultValue": "all",
                  "options": {
                    "all": {"label": "Toutes"},
                    "1": {"label": "Uniquement"},
                    "0": {"label": "Exclure"}
                  }
                }
              }
            },
            "department": {
              "groupSlug": "contentCollection",
              "priority": 50,
              "render": true,
              "subName": "department",
              "label": "Département",
              "description": "Code de département exact. Laisser vide pour ne pas filtrer.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {"name": "divi/text", "type": "field"}
            },
            "country": {
              "groupSlug": "contentCollection",
              "priority": 60,
              "render": true,
              "subName": "country",
              "label": "Pays",
              "description": "Code pays exact. Laisser vide pour ne pas filtrer.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {"name": "divi/text", "type": "field"}
            },
            "featured": {
              "groupSlug": "contentCollection",
              "priority": 70,
              "render": true,
              "subName": "featured",
              "label": "Mise en avant",
              "description": "Inclure toutes les fiches, uniquement celles mises en avant ou les exclure.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "defaultValue": "all",
                  "options": {
                    "all": {"label": "Toutes"},
                    "only": {"label": "Uniquement mises en avant"},
                    "exclude": {"label": "Exclure les mises en avant"}
                  }
                }
              }
            },
            "ids": {
              "groupSlug": "contentSelection",
              "priority": 10,
              "render": true,
              "subName": "ids",
              "label": "IDs explicites",
              "description": "Identifiants séparés par des virgules. Les règles publiques restent obligatoires.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {"name": "divi/text", "type": "field"}
            },
            "exclude_ids": {
              "groupSlug": "contentSelection",
              "priority": 20,
              "render": true,
              "subName": "exclude_ids",
              "label": "IDs exclus",
              "description": "Identifiants à exclure, séparés par des virgules.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {"name": "divi/text", "type": "field"}
            },
            "limit": {
              "groupSlug": "contentSelection",
              "priority": 30,
              "render": true,
              "subName": "limit",
              "label": "Limite",
              "description": "Nombre maximum de fiches. Zéro affiche toute la collection.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": {"min": 0, "max": 100, "minLimit": 0, "maxLimit": 100, "defaultUnit": "", "allowedUnits": [""]}
              }
            },
            "offset": {
              "groupSlug": "contentSelection",
              "priority": 40,
              "render": true,
              "subName": "offset",
              "label": "Décalage",
              "description": "Nombre de fiches à ignorer avant le rendu.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": {"min": 0, "max": 100, "minLimit": 0, "maxLimit": 100, "defaultUnit": "", "allowedUnits": [""]}
              }
            },
            "orderby": {
              "groupSlug": "contentSelection",
              "priority": 50,
              "render": true,
              "subName": "orderby",
              "label": "Tri",
              "description": "Critère de tri de la collection.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "defaultValue": "display_order",
                  "options": {
                    "display_order": {"label": "Ordre d’affichage"},
                    "name": {"label": "Nom"},
                    "date": {"label": "Date de publication"},
                    "id": {"label": "Identifiant"}
                  }
                }
              }
            },
            "order": {
              "groupSlug": "contentSelection",
              "priority": 60,
              "render": true,
              "subName": "order",
              "label": "Ordre",
              "description": "Ordre croissant ou décroissant.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "defaultValue": "asc",
                  "options": {"asc": {"label": "Croissant"}, "desc": {"label": "Décroissant"}}
                }
              }
            },
            "template": {
              "groupSlug": "contentSelection",
              "priority": 70,
              "render": true,
              "subName": "template",
              "label": "Template Content Kit",
              "description": "Rendu natif ou Template Annuaire publié.",
              "features": {"responsive": false, "hover": false, "sticky": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "defaultValue": "native",
                  "options": {"native": {"label": "Rendu natif"}}
                }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "inner": {
      "subName": "inner",
      "label": "Conteneur interne",
      "selectorSuffix": " .wp-seed-divi-directory-collection__inner"
    },
    "collection": {
      "subName": "collection",
      "label": "Annuaire",
      "selectorSuffix": " .wp-seed-directory"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentHeading": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentHeading",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {"groupLabel": "Titre"}
        }
      },
      "contentCollection": {
        "panel": "content",
        "priority": 20,
        "groupName": "contentCollection",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {"groupLabel": "Filtres"}
        }
      },
      "contentSelection": {
        "panel": "content",
        "priority": 30,
        "groupName": "contentSelection",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {"groupLabel": "Sélection et rendu"}
        }
      }
    }
  }
}
